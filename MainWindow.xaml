<Window x:Class="LOL_abilities_sound.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LOL_abilities_sound"
        mc:Ignorable="d"
        Closing="Window_Closing"
        Title="LOL Abilities Sound" Height="450" Width="800"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Icon="pack://application:,,,/Images/icon.ico"
        Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}" ResizeMode="CanMinimize" MinWidth="800" MaxWidth="800" MinHeight="450" MaxHeight="450">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.07*"/>
            <RowDefinition/>
            <RowDefinition Height="0.07*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.04*"/>
            <ColumnDefinition Width="185"/>
            <ColumnDefinition Width="0.03*"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="0.04*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="1" Grid.Column="1" CornerRadius="20" BorderThickness="2" BorderBrush="Black" Background="Black">
            <StackPanel Margin="10" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="image" Width="154" Height="280" Stretch="Fill" Margin="0,10"/>
                <Border Margin="0,16,0,0" Padding="8,4" Background="{DynamicResource SystemControlBackgroundChromeBlackMediumBrush}" CornerRadius="12" HorizontalAlignment="Center">
                    <ui:ToggleSwitch x:Name="startSwitch" Toggled="startSwitch_Toggled"
                        OffContent="Выключен"
                        OnContent="Включен"
                        Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                        Background="{DynamicResource SystemControlBackgroundChromeBlackMediumLowBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <ui:ToggleSwitch.Resources>
                            <Style TargetType="ui:ToggleSwitch">
                                <Setter Property="CornerRadius" Value="12"/>
                                <Setter Property="MinWidth" Value="80"/>
                                <Setter Property="MinHeight" Value="28"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="Padding" Value="4,0,4,0"/>
                            </Style>
                        </ui:ToggleSwitch.Resources>
                    </ui:ToggleSwitch>
                </Border>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Grid.Column="3" CornerRadius="20" BorderThickness="2" BorderBrush="{DynamicResource SystemControlBackgroundChromeBlackMediumLowBrush}" Background="{DynamicResource SystemControlBackgroundChromeBlackMediumLowBrush}">
            <Frame x:Name="frame" Margin="10" NavigationUIVisibility="Hidden"/>
        </Border>
    </Grid>
</Window>
