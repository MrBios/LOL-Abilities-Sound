<Page x:Class="LOL_abilities_sound.Pages.setAbilitiesSoundsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LOL_abilities_sound.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="350" d:DesignWidth="530"
      Title="setAbilitiesSoundsPage">
    <Page.Resources>
        <local:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter"/>
        <DataTemplate x:Key="championBorder">
            <Border BorderBrush="Black" Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}" Margin="0,0,0,15" BorderThickness="1" CornerRadius="15" Padding="9">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Cursor="Hand">
                        <Image Height="35" Width="35" Stretch="Fill"/>
                        <Label Content="Champion Name" VerticalAlignment="Center" Margin="10,0" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                    </StackPanel>
                    <StackPanel Visibility="Collapsed" Orientation="Vertical" Margin="20,10,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,10">
                            <Image Height="50" Width="50" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="Звук:" FontSize="15" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <TextBox Text="no sound" Margin="10,0" Width="300" Cursor="Hand" IsReadOnly="True" Focusable="False"/>
                                    <Image Height="25" Width="25" VerticalAlignment="Center" Cursor="Hand"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0" ToolTip="Время (в секундах) во время которого не будет воиспроизводиться звук повторно">
                                    <Label Content="Задержка (c):" FontSize="15" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <TextBox Text="70" Margin="10,0" Width="50" Cursor="Hand" HorizontalContentAlignment="Center"/>
                                    <Image Height="25" Width="25" VerticalAlignment="Center" Cursor="Hand"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10">
                            <Image Height="50" Width="50" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="Звук:" FontSize="15" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <TextBox Text="no sound" Margin="10,0" Width="300" Cursor="Hand" IsReadOnly="True" Focusable="False"/>
                                    <Image Height="25" Width="25" VerticalAlignment="Center" Cursor="Hand"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0" ToolTip="Время (в секундах) во время которого не будет воиспроизводиться звук повторно">
                                    <Label Content="Задержка (c):" FontSize="15" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <TextBox Text="70" Margin="10,0" Width="50" Cursor="Hand" HorizontalContentAlignment="Center"/>
                                    <Image Height="25" Width="25" VerticalAlignment="Center" Cursor="Hand"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10">
                            <Image Height="50" Width="50" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="Звук:" FontSize="15" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <TextBox Text="no sound" Margin="10,0" Width="300" Cursor="Hand" IsReadOnly="True" Focusable="False"/>
                                    <Image Height="25" Width="25" VerticalAlignment="Center" Cursor="Hand"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0" ToolTip="Время (в секундах) во время которого не будет воиспроизводиться звук повторно">
                                    <Label Content="Задержка (c):" FontSize="15" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <TextBox Text="70" Margin="10,0" Width="50" Cursor="Hand" HorizontalContentAlignment="Center"/>
                                    <Image Height="25" Width="25" VerticalAlignment="Center" Cursor="Hand"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10">
                            <Image Height="50" Width="50" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="Звук:" FontSize="15" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <TextBox Text="no sound" Margin="10,0" Width="300" Cursor="Hand" IsReadOnly="True" Focusable="False"/>
                                    <Image Height="25" Width="25" VerticalAlignment="Center" Cursor="Hand"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0" ToolTip="Время (в секундах) во время которого не будет воиспроизводиться звук повторно">
                                    <Label Content="Задержка (c):" FontSize="15" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <TextBox Text="70" Margin="10,0" Width="50" Cursor="Hand" HorizontalContentAlignment="Center"/>
                                    <Image Height="25" Width="25" VerticalAlignment="Center" Cursor="Hand"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.35*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Image Name="back" Height="30" Width="30" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" Cursor="Hand" MouseLeftButtonDown="back_MouseLeftButtonDown"/>
        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
            <Label Content="Установка звуков на умения чемпионов" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Grid>
                <TextBox x:Name="SearchBox" Margin="10" FontSize="13" TextChanged="SearchBox_TextChanged"/>
                <TextBlock Text="Поиск по имени чемпиона..." Margin="27,0,0,0" VerticalAlignment="Center" Foreground="Gray" IsHitTestVisible="False" FontSize="13" Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"/>
            </Grid>
        </StackPanel>
        <ScrollViewer Padding="5,0,25,0" Grid.Row="1">
            <StackPanel x:Name="content" Orientation="Vertical">
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
